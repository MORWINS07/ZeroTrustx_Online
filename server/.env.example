# ZeroTrustX Server Environment Configuration
# Copy this file to .env and fill in your values

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=5000
APP_NAME=ZeroTrustX

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/zerotrustx

# ── JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
JWT_ACCESS_SECRET=your-access-token-secret-here
JWT_MFA_SECRET=your-mfa-challenge-token-secret-here

# ── Token Lifetimes ──────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRES_IN=15m
SESSION_DURATION_MS=604800000   # 7 days in ms

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── IMPORTANT ─────────────────────────────────────────────────────────────────
# NEVER commit real secrets to version control
# Generate strong random secrets for production
